server {
    listen 0.0.0.0:443 ssl;
    http2 on;
    server_name pulsecore-app.ru www.pulsecore-app.ru;

    location /ws {
        proxy_pass http://spring_app:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
    }

    location / {
        proxy_pass http://spring_app:8080;
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    ssl_certificate /etc/letsencrypt/live/pulsecore-app.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pulsecore-app.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 0.0.0.0:80;
    server_name pulsecore-app.ru www.pulsecore-app.ru;
    return 301 https://$host$request_uri;
}