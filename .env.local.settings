# Очистка битых турниров
# START: на сколько дней назад от сегодняшнего дня смотреть (глубина истории)
# END: на сколько дней вперёд от сегодняшнего дня смотреть (0 = только сегодня и прошлое)
TOURNAMENT_CLEANUP_START=30
TOURNAMENT_CLEANUP_END=3

# Фоновая загрузка данных игрока (турниры, матчи, результаты)
# START: за сколько дней от сегодняшнего дня загружать
# END: до какой даты загружать (2023-01-01)
TOURNAMENT_PLAYER_HISTORY_START=1
TOURNAMENT_PLAYER_HISTORY_END=2023-01-01


# Подписка: пробный период при регистрации
# TRIAL_DAYS: сколько дней даётся бесплатно при создании игрока
PLAYER_TRIAL_DAYS=7


# Кэш: время жизни хеша discovery (в формате Spring Duration: 6h, 30m, 2h)
# APP_CACHE_DISCOVERY_HASH_TTL: как долго хранить хеш в кэше
APP_CACHE_DISCOVERY_HASH_TTL=2h


# Кэш составов (LineupHashCache): как долго хранить хеш состава
# Влияет на нагрузку: меньше TTL — чаще парсим сайт
TOURNAMENT_CACHE_LINEUP_HASH_TTL=6h

# Кэш статуса турнира (TournamentStatusCache): как долго считать турнир «в процессе»
# Влияет на частоту проверок: меньше TTL — чаще проверяем
TOURNAMENT_CACHE_TOURNAMENT_STATUS_TTL=30m